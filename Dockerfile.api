# syntax=docker/dockerfile:1

FROM node:24-bookworm-slim AS deps
WORKDIR /app
RUN npm install -g pnpm@11.5.2
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3001
WORKDIR /app
# OPS-06: paket OS base image tertinggal patch keamanan Debian (libpam-modules 1.5.2-6+deb12u2,
# CVE-2025-6020 HIGH fixable di deb12u3); upgrade sebelum scan Trivy.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
# OPS-06: npm bawaan base image membawa brace-expansion 5.0.9 dan undici 6.28.0 (CVE HIGH fixable).
RUN npm install -g npm@11.21.3 && npm cache clean --force
RUN npm install -g --allow-scripts=esbuild tsx@4.23.15
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.json ./
COPY --chown=node:node server ./server
# Direktori bukti wali milik `node` agar volume bernama bisa ditulis tanpa root.
RUN mkdir -p /app/var/guardian-evidence && chown -R node:node /app/var
USER node
EXPOSE 3001
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3001/api/v1/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
CMD ["tsx", "server/index.ts"]
