# Salin ke .env atau ekspor di shell. Jangan commit nilai rahasia produksi.
# --- Web (Next.js) ---
PORT=3000
HOST=127.0.0.1
# API internal untuk guard sesi server component (default 3001).
API_INTERNAL_URL=http://127.0.0.1:3001
# Target rewrite /api/:path* untuk `next dev` dan build lokal.
API_ORIGIN=http://127.0.0.1:3001
# Nilai rewrite yang dibekukan saat build image web Docker Compose.
API_ORIGIN_BUILD=http://api:3001

# --- API (Express) ---
# Sumber data runtime satu-satunya. Tidak ada fallback SQLite.
DATABASE_URL=postgres://svara:svara_dev_password@127.0.0.1:5432/svara
# Batas pool koneksi per proses (1-50).
PG_POOL_MAX=10
# Jaringan proxy yang header X-Forwarded-For/Proto-nya dipercaya untuk req.ip, req.secure, dan identitas klien rate limiter.
# Kosong/0 = mati (default): header proxy diabaikan. Nilai: loopback | linklocal | uniquelocal (boleh digabung koma).
# Jumlah hop (1, 2), true, *, dan rentang IP tidak diterima: API memberi peringatan dan mematikan trust proxy.
# Isi hanya bila ingress tepercaya di depan API menambahkan atau menimpa X-Forwarded-For dan X-Forwarded-Proto.
# Rewrite Next dan compose web->api meneruskan header dari klien apa adanya, sehingga klien bisa memalsukan alamatnya.
# Tanpa ingress seperti itu, biarkan kosong dan pakai COOKIE_SECURE=1 untuk HTTPS. Lihat README, "Header proxy dan TRUST_PROXY".
TRUST_PROXY=
# Origin UI yang diizinkan. Pisahkan dengan koma untuk beberapa origin.
# Lewat Next rewrite, origin browser adalah http://localhost:3000.
APP_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
# 1 = cookie sesi dan cookie responden selalu memakai atribut Secure.
# Kosong = Secure bila koneksi HTTPS terpercaya (TLS langsung, atau X-Forwarded-Proto dari ingress di jaringan TRUST_PROXY),
#          atau bila NODE_ENV=production dan seluruh APP_ORIGIN memakai https://.
# 0 = rekomendasi lokal; mematikan paksaan default produksi (permintaan HTTPS tetap memakai Secure).
# Jangan mengisi TRUST_PROXY hanya demi X-Forwarded-Proto bila tidak ada ingress yang menambahkan atau menimpa header proxy.
COOKIE_SECURE=
# HSTS (max-age=15552000; includeSubDomains) hanya untuk permintaan HTTPS.
# Kosong = aktif bila NODE_ENV=production dan seluruh APP_ORIGIN https://; 1 memaksa; 0 mematikan.
ENABLE_HSTS=
SESSION_TTL_HOURS=8
# Ganti dengan token acak yang kuat pada deployment.
INTEGRATION_TOKEN=ubah-token-integrasi-lokal
# Ganti dengan ID organisasi pemilik token; tanpa cakupan permintaan integrasi ditolak.
INTEGRATION_ORGANIZATION_ID=
# Direktori berkas bukti wali (default ./var/guardian-evidence). Gunakan volume persisten;
# berkas tidak disimpan di basis data dan hanya disajikan lewat route ber-sesi org_admin.
GUARDIAN_EVIDENCE_DIR=./var/guardian-evidence
# Masa simpan permintaan data (hari, >= 1) untuk pnpm retention:data-requests.
DATA_REQUEST_RETENTION_DAYS=365
# Seed data demo hanya aktif jika 1. Ditolak saat NODE_ENV=production.
SEED_DEMO=0
# Sandi akun sintetis; hanya dipakai bila SEED_DEMO=1.
SEED_PASSWORD=ubah-sandi-seed-lokal
# Bootstrap admin awal; isi lewat environment/secret manager, bukan file ini.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=Ganti-Sandi-Kuat-2026!
# Basis data uji terpisah untuk `pnpm test` dan `pnpm demo:*`.
# TEST_DATABASE_URL=postgres://svara:svara_dev_password@127.0.0.1:5432/svara_test
