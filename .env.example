# Salin ke .env atau ekspor di shell. Jangan commit nilai rahasia produksi.
PORT=3000
HOST=127.0.0.1
DB_PATH=data/svara.sqlite
APP_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=0
# Aktifkan hanya di deployment HTTPS yang sudah pasti.
ENABLE_HSTS=0
SESSION_TTL_HOURS=8
# Ganti dengan token acak yang kuat pada deployment.
INTEGRATION_TOKEN=ubah-token-integrasi-lokal
# Seed data demo hanya aktif jika 1. Ditolak saat NODE_ENV=production.
SEED_DEMO=0
# Sandi akun sintetis; hanya dipakai bila SEED_DEMO=1.
SEED_PASSWORD=ubah-sandi-seed-lokal
# Bootstrap admin awal; isi lewat environment/secret manager, bukan file ini.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=ubah-sandi-kuat
