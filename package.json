{
  "name": "modul14-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"next dev -p 3000\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "next dev -p 3000",
    "db:migrate": "tsx server/migrate.ts",
    "db:reset": "tsx server/seed.ts --reset",
    "db:seed": "tsx server/seed.ts",
    "admin:bootstrap": "tsx server/scripts/bootstrap-admin.ts",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "build": "pnpm typecheck && next build",
    "start": "concurrently -k -n api,web -c blue,green \"tsx server/index.ts\" \"next start -p 3000\"",
    "start:api": "tsx server/index.ts",
    "start:web": "next start -p 3000",
    "test": "pnpm typecheck && tsx server/test/migrations.test.ts && tsx server/test/api.test.ts && tsx server/test/export.test.ts && tsx server/test/report-versions.test.ts && tsx server/test/seed-policy.test.ts",
    "lint": "eslint .",
    "smoke:web": "node scripts/smoke-web.mjs",
    "demo:ac13": "tsx server/scripts/ac13-load.ts",
    "demo:ac15": "tsx server/scripts/ac15-restore.ts",
    "demo:ac16": "tsx server/scripts/ac16-walkthrough.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "express": "^5.3.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^10.0.7",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "packageManager": "pnpm@11.5.2"
}
